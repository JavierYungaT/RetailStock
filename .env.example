# Plantilla de secretos para docker compose. Copia este archivo a ".env" (ignorado por git) y cambia los valores.
#   cp .env.example .env
#
# Contraseña del usuario "sa" de SQL Server: mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
# Solo se aplica la PRIMERA vez que se crea el volumen de datos.
SA_PASSWORD=CambiaEsta_Clave123!

# Clave para firmar los JWT (HMAC-SHA256): mínimo 32 caracteres aleatorios.
# Generar una:  openssl rand -base64 48
JWT_KEY=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
